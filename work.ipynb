   "source": [
    "# 반복문 while\n",
    "# while n > 0 = \"n > 0 때까지 반복해\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b4ea6dd8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5 초 전\n",
      "4 초 전\n",
      "3 초 전\n",
      "2 초 전\n",
      "1 초 전\n",
      "발사!\n"
     ]
    }
   ],
   "source": [
    "n = 5\n",
    "while n > 0:\n",
    "    print(n, \"초 전\")\n",
    "    n = n - 1\n",
    "print(\"발사!\")"
   ]
  },
