   "id": "ef53ee97",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n",
      "2\n",
      "3\n",
      "영희야, 안녕?\n",
      "철수야, 안녕?\n"
     ]
    }
   ],
   "source": [
    "for a in [1, 2, 3]:\n",
    "    print(a)\n",
    "for 학생 in [\"영희\", \"철수\"]:\n",
    "    print(학생 + \"야, 안녕?\")"
   ]
  },
  {
